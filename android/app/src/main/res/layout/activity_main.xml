<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <!-- Header & Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SOAR TUNNEL"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="@color/primary_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DNS Tunnel SOCKS5 Proxy"
                android:textSize="11sp"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <!-- Status Badge -->
        <LinearLayout
            android:id="@+id/layoutStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface_dark"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">

            <View
                android:id="@+id/viewStatusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@color/status_red"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_disconnected"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_light" />
        </LinearLayout>
    </LinearLayout>

    <!-- Configuration Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface_dark"
        app:strokeColor="@color/border_dark"
        app:strokeWidth="1dp"
        app:cardCornerRadius="8dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Server Key Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/server_key"
                android:textColorHint="@color/text_muted"
                app:boxStrokeColor="@color/primary_accent"
                android:layout_marginBottom="8dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etServerKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_light"
                    android:textSize="12sp"
                    android:maxLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Tunnel Domains Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/tunnel_domains"
                android:textColorHint="@color/text_muted"
                app:boxStrokeColor="@color/primary_accent"
                android:layout_marginBottom="8dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDomains"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_light"
                    android:textSize="12sp"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- SOCKS Port -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/socks_port"
                android:textColorHint="@color/text_muted"
                app:boxStrokeColor="@color/primary_accent"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="10850"
                    android:inputType="number"
                    android:textColor="@color/text_light"
                    android:textSize="12sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Connect Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/connect"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        app:backgroundTint="@color/primary_accent"
        app:cornerRadius="6dp"
        android:layout_marginBottom="8dp" />

    <!-- Action Shortcuts -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyProxy"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="@string/copy_socks"
            android:textSize="11sp"
            android:textColor="@color/text_light"
            app:backgroundTint="@color/surface_dark"
            app:strokeColor="@color/border_dark"
            app:strokeWidth="1dp"
            app:cornerRadius="6dp"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenTelegram"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="@string/open_telegram"
            android:textSize="11sp"
            android:textColor="@color/text_light"
            app:backgroundTint="@color/surface_dark"
            app:strokeColor="@color/border_dark"
            app:strokeWidth="1dp"
            app:cornerRadius="6dp" />
    </LinearLayout>

    <!-- Live Terminal Log -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/terminal_bg"
        app:strokeColor="@color/border_dark"
        app:strokeWidth="1dp"
        app:cardCornerRadius="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LIVE CONSOLE LOGS"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_muted" />

                <TextView
                    android:id="@+id/tvClearLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clear_logs"
                    android:textSize="10sp"
                    android:textColor="@color/primary_accent"
                    android:padding="4dp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/scrollLogs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/tvLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/terminal_green"
                    android:typeface="monospace"
                    android:textSize="10sp"
                    android:textIsSelectable="true" />
            </ScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
