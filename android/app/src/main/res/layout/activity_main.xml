<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="14dp">

    <!-- Header & Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SOAR TUNNEL"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/primary_accent" />

                <TextView
                    android:id="@+id/tvVersionTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v1.0.7"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#0369A1"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="2dp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Multi-Domain DNS SOCKS5 Tunnel"
                android:textSize="10.5sp"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <!-- About & Update Buttons -->
        <ImageButton
            android:id="@+id/btnCheckUpdate"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/stat_sys_download"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/text_muted"
            android:contentDescription="Check Update"
            android:layout_marginEnd="6dp" />

        <ImageButton
            android:id="@+id/btnAbout"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_info_details"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/text_muted"
            android:contentDescription="About"
            android:layout_marginEnd="8dp" />

        <!-- Status Badge -->
        <LinearLayout
            android:id="@+id/layoutStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface_dark"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp">

            <View
                android:id="@+id/viewStatusDot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:background="@color/status_red"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_disconnected"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/text_light" />
        </LinearLayout>
    </LinearLayout>

    <!-- Profile Selector Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <Spinner
            android:id="@+id/spnProfiles"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@color/surface_dark"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnAddProfile"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="+"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/primary_accent"
            android:backgroundTint="@color/surface_dark"
            android:padding="0dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnImportLink"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Import"
            android:textSize="11sp"
            android:textColor="@color/text_light"
            android:backgroundTint="@color/surface_dark"
            android:paddingHorizontal="8dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnShareProfile"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Share"
            android:textSize="11sp"
            android:textColor="@color/text_light"
            android:backgroundTint="@color/surface_dark"
            android:paddingHorizontal="8dp" />

        <ImageButton
            android:id="@+id/btnDeleteProfile"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_delete"
            android:backgroundTint="@color/surface_dark"
            app:tint="@color/status_red"
            android:contentDescription="Delete Server Profile"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Configuration Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface_dark"
        app:strokeColor="@color/border_dark"
        app:strokeWidth="1dp"
        app:cardCornerRadius="8dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Server Key Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/server_key"
                android:textColorHint="@color/text_muted"
                app:boxStrokeColor="@color/primary_accent"
                android:layout_marginBottom="6dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etServerKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_light"
                    android:textSize="11sp"
                    android:maxLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Tunnel Domains Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/tunnel_domains"
                android:textColorHint="@color/text_muted"
                app:boxStrokeColor="@color/primary_accent"
                android:layout_marginBottom="6dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDomains"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_light"
                    android:textSize="11sp"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Port and Resolver Test Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/socks_port"
                    android:textColorHint="@color/text_muted"
                    app:boxStrokeColor="@color/primary_accent"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPort"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="10850"
                        android:inputType="number"
                        android:textColor="@color/text_light"
                        android:textSize="11sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestResolvers"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Test Resolvers"
                    android:textSize="10.5sp"
                    android:textColor="@color/primary_accent"
                    app:backgroundTint="#161F2E"
                    app:strokeColor="@color/border_dark"
                    app:strokeWidth="1dp"
                    app:cornerRadius="6dp" />
            </LinearLayout>

            <!-- DNS Resolvers Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/dns_resolvers"
                android:textColorHint="@color/text_muted"
                app:boxStrokeColor="@color/primary_accent"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etResolvers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_light"
                    android:textSize="10.5sp"
                    android:inputType="textMultiLine"
                    android:lines="2"
                    android:maxLines="4"
                    android:gravity="top|start" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Connect Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/connect"
        android:textSize="13.5sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        app:backgroundTint="@color/primary_accent"
        app:cornerRadius="6dp"
        android:layout_marginBottom="6dp" />

    <!-- Action Shortcuts -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyProxy"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="@string/copy_socks"
            android:textSize="10.5sp"
            android:textColor="@color/text_light"
            app:backgroundTint="@color/surface_dark"
            app:strokeColor="@color/border_dark"
            app:strokeWidth="1dp"
            app:cornerRadius="6dp"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenTelegram"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="@string/open_telegram"
            android:textSize="10.5sp"
            android:textColor="@color/text_light"
            app:backgroundTint="@color/surface_dark"
            app:strokeColor="@color/border_dark"
            app:strokeWidth="1dp"
            app:cornerRadius="6dp" />
    </LinearLayout>

    <!-- Live Terminal Log -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/terminal_bg"
        app:strokeColor="@color/border_dark"
        app:strokeWidth="1dp"
        app:cardCornerRadius="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tvLiveTelemetry"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LIVE CONSOLE &amp; TELEMETRY"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_muted" />

                <TextView
                    android:id="@+id/tvClearLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clear_logs"
                    android:textSize="9.5sp"
                    android:textColor="@color/primary_accent"
                    android:padding="3dp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/scrollLogs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/tvLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/terminal_green"
                    android:typeface="monospace"
                    android:textSize="9.5sp"
                    android:textIsSelectable="true" />
            </ScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
