<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface_dark"
    app:strokeColor="@color/border_dark"
    app:strokeWidth="1dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <!-- Status Indicator Dot -->
        <View
            android:id="@+id/viewStatusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_status_dot"
            android:layout_marginEnd="12dp" />

        <!-- Info Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Resolver IP:Port -->
            <TextView
                android:id="@+id/tvResolverAddr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="178.22.122.100:53"
                android:textSize="14sp"
                android:textStyle="bold"
                android:typeface="monospace"
                android:textColor="@color/text_light"
                android:layout_marginBottom="4dp" />

            <!-- Badges & Subtext Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvRegionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IRAN"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#38BDF8"
                    android:background="@drawable/bg_badge_subtle"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvEdnsBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1400B"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_muted"
                    android:background="@drawable/bg_badge_subtle"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvResolverStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Score: 98 • 15 ok / 0 err"
                    android:textSize="10.5sp"
                    android:textColor="@color/text_muted"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Latency Badge Pill -->
        <TextView
            android:id="@+id/tvLatencyBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="38 ms"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/status_green"
            android:background="@drawable/bg_pill_latency"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp" />

        <!-- More Options Menu Button -->
        <ImageButton
            android:id="@+id/btnCardMenu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_more"
            app:tint="@color/text_muted"
            android:contentDescription="Resolver Options"
            android:padding="6dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
