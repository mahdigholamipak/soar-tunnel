<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface_dark"
    app:strokeColor="@color/border_dark"
    app:strokeWidth="1dp"
    app:cardCornerRadius="8dp"
    android:layout_marginBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <!-- Status Indicator Dot -->
        <View
            android:id="@+id/viewStatusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@color/status_green"
            android:layout_marginEnd="8dp" />

        <!-- Info Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Address + Badges -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvResolverAddr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="178.22.122.100:53"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:typeface="monospace"
                    android:textColor="#F8FAFC"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvRegionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IRAN"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:textColor="#60A5FA"
                    android:background="#1E3A8A"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tvEdnsBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1400B"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:textColor="#34D399"
                    android:background="#064E3B"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp" />
            </LinearLayout>

            <!-- Stats Subtext -->
            <TextView
                android:id="@+id/tvResolverStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Score: 98.4 • Success: 15 • Fail: 0"
                android:textSize="9.5sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Latency Badge -->
        <TextView
            android:id="@+id/tvLatencyBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="38.2 ms"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="@color/status_green"
            android:background="#1E293B"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:layout_marginEnd="8dp" />

        <!-- Actions: Test, Edit, Delete -->
        <ImageButton
            android:id="@+id/btnTestSingle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_rotate"
            app:tint="@color/primary_accent"
            android:contentDescription="Test resolver"
            android:layout_marginEnd="2dp" />

        <ImageButton
            android:id="@+id/btnEditSingle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/status_amber"
            android:contentDescription="Edit resolver"
            android:layout_marginEnd="2dp" />

        <ImageButton
            android:id="@+id/btnDeleteSingle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/status_red"
            android:contentDescription="Delete resolver" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
