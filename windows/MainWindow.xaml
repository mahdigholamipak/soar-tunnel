<Window x:Class="SoarClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Soar DNS Tunnel" Height="680" Width="920"
        MinHeight="580" MinWidth="800"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1A2230" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#2D3B50" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Main Content: Settings & Logs -->
            <RowDefinition Height="*" />
            <!-- Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="4,0,4,12" BorderBrush="#1F2937" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SOAR" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,8,0" />
                        <TextBlock Text="DNS TUNNEL" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" />
                    </StackPanel>
                    <TextBlock Text="High-Performance Loss-Tolerant DNS Tunneling" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Status Pill -->
                <Border Grid.Column="1" Background="#161F2E" CornerRadius="16" Padding="14,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#EF4444" Margin="0,0,8,0" />
                        <TextBlock x:Name="StatusText" Text="Disconnected" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Body: Split Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Configuration & Controls (360px) -->
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="16" />
                <!-- Real-time Console Log (Fill) -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Configuration Card -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Server Public Key -->
                        <TextBlock Text="SERVER PUBLIC KEY" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtServerKey" Margin="0,0,0,12" ToolTip="32-byte Ed25519 Base64 Public Key" />

                        <!-- Tunnel Domains -->
                        <TextBlock Text="TUNNEL DOMAINS (ZONES)" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtDomains" Margin="0,0,0,4" ToolTip="Comma-separated zones, e.g. s.he7.ir, s.he6.ir" />
                        <TextBlock Text="Supports multiple domains for automatic failover" FontSize="10" Foreground="#64748B" Margin="0,0,0,12" />

                        <!-- SOCKS5 Port & IP -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="LISTEN IP" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtListenIP" Text="127.0.0.1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PORT" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtListenPort" Text="10850" />
                            </StackPanel>
                        </Grid>

                        <!-- Resolvers File -->
                        <TextBlock Text="RESOLVERS FILE" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtResolversFile" Text="client_resolvers.txt" Margin="0,0,0,16" />

                        <!-- System Proxy Checkbox -->
                        <CheckBox x:Name="ChkSystemProxy" Content="Set as Windows System Proxy" Foreground="#E2E8F0" FontSize="12" Margin="0,0,0,16" IsChecked="True" ToolTip="Automatically routes Windows and browser traffic through the tunnel" />

                        <!-- Connect / Disconnect Button -->
                        <Button x:Name="BtnConnect" Click="BtnConnect_Click" Height="42" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" BorderThickness="0" Margin="0,0,0,10">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </Button.Resources>
                            CONNECT
                        </Button>

                        <!-- Quick Action Buttons -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnCopyProxy" Grid.Column="0" Click="BtnCopyProxy_Click" Height="32" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" FontSize="11" Content="Copy Proxy" />
                            <Button x:Name="BtnSaveConfig" Grid.Column="2" Click="BtnSaveConfig_Click" Height="32" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" FontSize="11" Content="Save Config" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Live Console Log Card -->
            <Border Grid.Column="2" Background="#0B0F17" CornerRadius="8" Padding="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Log Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="LIVE TELEMETRY &amp; TUNNEL LOGS" FontWeight="SemiBold" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Click="BtnClearLogs_Click" Content="Clear" Height="24" Padding="10,2" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" FontSize="11" />
                    </Grid>

                    <!-- Terminal Output -->
                    <TextBox x:Name="TxtConsoleLog" Grid.Row="1" Background="#080C14" Foreground="#10B981" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11.5" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="Wrap" BorderThickness="0" Padding="8" />
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Proxy target: socks5://127.0.0.1:10850 | Telegram: tg://socks?server=127.0.0.1&amp;port=10850" FontSize="11" Foreground="#475569" VerticalAlignment="Center" />
            <TextBlock x:Name="TxtStats" HorizontalAlignment="Right" Text="Idle" FontSize="11" Foreground="#0284C7" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
