<Window x:Class="SoarClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Soar DNS Tunnel" Height="740" Width="1020"
        MinHeight="650" MinWidth="900"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1A2230" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#2D3B50" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1A2230" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#2D3B50" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="#111827" BorderBrush="#1F2937" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Margin="0,0,4,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#161D28" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#0EA5E9" />
                                <Setter Property="Foreground" Value="#0EA5E9" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Main Content: Settings & Logs -->
            <RowDefinition Height="*" />
            <!-- Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,14" Padding="4,0,4,12" BorderBrush="#1F2937" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SOAR" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,8,0" />
                        <TextBlock Text="DNS TUNNEL" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,12,0" />
                        <Border Background="#0369A1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="v1.5.1" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Resilient Multi-Domain DNS Tunneling | Based on Lantern Soar Protocol" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Right Header: Telemetry & Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Live Speed Indicators -->
                    <Border Background="#111827" CornerRadius="6" Padding="10,5" Margin="0,0,10,0" BorderBrush="#1F2937" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↓ " Foreground="#10B981" FontWeight="Bold" FontSize="11" />
                            <TextBlock x:Name="TxtSpeedRx" Text="0.0 KB/s" Foreground="#F8FAFC" FontSize="11" Margin="0,0,10,0" />
                            <TextBlock Text="↑ " Foreground="#38BDF8" FontWeight="Bold" FontSize="11" />
                            <TextBlock x:Name="TxtSpeedTx" Text="0.0 KB/s" Foreground="#F8FAFC" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <!-- Status Pill -->
                    <Border Background="#161F2E" CornerRadius="16" Padding="12,6" VerticalAlignment="Center" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#EF4444" Margin="0,0,6,0" />
                            <TextBlock x:Name="StatusText" Text="Disconnected" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="11.5" />
                        </StackPanel>
                    </Border>

                    <!-- Check Updates & About -->
                    <Button x:Name="BtnCheckUpdate" Click="BtnCheckUpdate_Click" Height="28" Padding="8,2" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" FontSize="11" Content="Update" Margin="0,0,6,0" ToolTip="Check GitHub for newer versions" />
                    <Button x:Name="BtnAbout" Click="BtnAbout_Click" Height="28" Padding="8,2" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" FontSize="11" Content="About" ToolTip="View protocol credits &amp; license" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Split Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Control Panel (360px) -->
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="14" />
                <!-- Right Tabbed Panel (Fill) -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Control Panel -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <!-- Profile Card -->
                    <RowDefinition Height="Auto" />
                    <!-- Hero Connect Card -->
                    <RowDefinition Height="Auto" />
                    <!-- Options Card -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Profile Card -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="ACTIVE SERVER PROFILE" FontWeight="SemiBold" Foreground="#38BDF8" FontSize="11" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbProfiles" Grid.Column="0" SelectionChanged="CmbProfiles_SelectionChanged" />
                            <Button x:Name="BtnAddProfile" Grid.Column="2" Click="BtnAddProfile_Click" Content="+" Width="28" Height="28" Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" FontSize="14" BorderBrush="#334155" ToolTip="Add New Server Profile" />
                            <Button x:Name="BtnDeleteProfile" Grid.Column="4" Click="BtnDeleteProfile_Click" Content="✕" Width="28" Height="28" Background="#1E293B" Foreground="#EF4444" FontSize="11" BorderBrush="#334155" ToolTip="Delete Current Profile" />
                        </Grid>

                        <!-- Import / Share Action Bar -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnImportLink" Grid.Column="0" Click="BtnImportLink_Click" Height="28" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" FontSize="11" Content="Import Link" ToolTip="Import soar:// profile link" />
                            <Button x:Name="BtnShareProfile" Grid.Column="2" Click="BtnShareProfile_Click" Height="28" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" FontSize="11" Content="Share / QR..." ToolTip="Share link or view QR code" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Hero Connect Card -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- Big Connect Button -->
                        <Button x:Name="BtnConnect" Click="BtnConnect_Click" Height="48" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" BorderThickness="0" Margin="0,0,0,12" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Button.Resources>
                            CONNECT
                        </Button>

                        <!-- Telemetry Grid -->
                        <Border Background="#0F172A" CornerRadius="6" Padding="10,8" Margin="0,0,0,12" BorderBrush="#1E293B" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="DOWNLOAD" FontSize="9.5" Foreground="#64748B" FontWeight="Bold" />
                                    <TextBlock x:Name="TxtHeroRx" Text="0.0 KB/s" FontSize="12.5" FontWeight="SemiBold" Foreground="#10B981" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBlock Text="UPLOAD" FontSize="9.5" Foreground="#64748B" FontWeight="Bold" />
                                    <TextBlock x:Name="TxtHeroTx" Text="0.0 KB/s" FontSize="12.5" FontWeight="SemiBold" Foreground="#38BDF8" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="ACTIVE STREAMS" FontSize="9.5" Foreground="#64748B" FontWeight="Bold" />
                                    <TextBlock x:Name="TxtHeroStreams" Text="0" FontSize="12.5" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="1">
                                    <TextBlock Text="TOTAL DATA" FontSize="9.5" Foreground="#64748B" FontWeight="Bold" />
                                    <TextBlock x:Name="TxtHeroTotal" Text="0 MB" FontSize="12.5" FontWeight="SemiBold" Foreground="#94A3B8" />
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2">
                                    <TextBlock x:Name="TxtHeroTuner" Text="⚡ Auto-Tuner: Ready" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Quick Action Shortcuts -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnCopyProxy" Grid.Column="0" Click="BtnCopyProxy_Click" Height="30" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" FontSize="11" Content="Copy SOCKS" />
                            <Button x:Name="BtnExportV2ray" Grid.Column="2" Click="BtnExportV2ray_Click" Height="30" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" FontSize="11" Content="v2ray / Clash" ToolTip="Copy URI for v2rayN, Clash, and Nekoray" />
                            <Button x:Name="BtnLaunchTelegram" Grid.Column="4" Click="BtnLaunchTelegram_Click" Height="30" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" FontSize="11" Content="Telegram" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Options Card -->
                <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="CONNECTION OPTIONS" FontWeight="SemiBold" Foreground="#38BDF8" FontSize="11" Margin="0,0,0,8" />
                        <CheckBox x:Name="ChkSystemProxy" Click="ChkSystemProxy_Click" Content="Set as Windows System Proxy" Foreground="#E2E8F0" FontSize="11.5" Margin="0,0,0,8" IsChecked="False" ToolTip="Automatically routes Windows and browser traffic through the tunnel" />
                        <CheckBox x:Name="ChkMinimizeToTray" Content="Minimize to System Tray on close" Foreground="#E2E8F0" FontSize="11.5" Margin="0,0,0,10" IsChecked="True" />
                        <CheckBox x:Name="ChkAutoDetectClipboard" Content="Auto-detect profile in clipboard" Foreground="#E2E8F0" FontSize="11.5" Margin="0,0,0,8" IsChecked="True" ToolTip="Prompt to import when copying a soar:// link" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Right Tabbed Panel -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TabControl x:Name="MainTabs">
                    <!-- Tab 1: Terminal & Live Console -->
                    <TabItem Header="📜 Live Console">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TELEMETRY &amp; TUNNEL LOGS" FontWeight="SemiBold" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Click="BtnCopyLogs_Click" Content="Copy All" Height="24" Padding="10,2" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" FontSize="11" ToolTip="Copy all logs to clipboard" />
                                <Button Grid.Column="3" Click="BtnClearLogs_Click" Content="Clear" Height="24" Padding="10,2" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" FontSize="11" />
                            </Grid>

                            <!-- Syntax Highlighted Rich Log Console -->
                            <RichTextBox x:Name="RtbConsoleLog" Grid.Row="1" Background="#080C14" Foreground="#94A3B8" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Padding="8">
                                <RichTextBox.Resources>
                                    <Style TargetType="Paragraph">
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="LineHeight" Value="16" />
                                    </Style>
                                </RichTextBox.Resources>
                                <FlowDocument />
                            </RichTextBox>
                        </Grid>
                    </TabItem>

                    <!-- Tab 2: Resolver Bank & Scanner -->
                    <TabItem Header="🌐 Resolvers &amp; Bank">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <!-- Row 0: Search & Filter Pills -->
                                <RowDefinition Height="Auto" />
                                <!-- Row 1: Actions Toolbar -->
                                <RowDefinition Height="Auto" />
                                <!-- Row 2: Status & Counts -->
                                <RowDefinition Height="Auto" />
                                <!-- Row 3: Main Cards ListView -->
                                <RowDefinition Height="*" />
                                <!-- Row 4: Raw Text Editor (Collapsible) -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Search & Filter Bar -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Search Box -->
                                <TextBox x:Name="TxtResolverSearch" Grid.Column="0" Height="28" TextChanged="TxtResolverSearch_TextChanged" VerticalContentAlignment="Center" Padding="8,2" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#1E293B" BorderThickness="1" FontSize="11" ToolTip="Filter by IP address or port" />
                                
                                <!-- Filter Pills -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button x:Name="BtnFilterAll" Click="BtnFilterAll_Click" Content="All (40)" Height="28" Padding="10,2" Margin="0,0,4,0" Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand" />
                                    <Button x:Name="BtnFilterHealthy" Click="BtnFilterHealthy_Click" Content="Healthy" Height="28" Padding="10,2" Margin="0,0,4,0" Background="#1E293B" Foreground="#10B981" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand" />
                                    <Button x:Name="BtnFilterFast" Click="BtnFilterFast_Click" Content="Fast (&lt;100ms)" Height="28" Padding="10,2" Margin="0,0,4,0" Background="#1E293B" Foreground="#38BDF8" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand" />
                                    <Button x:Name="BtnFilterIran" Click="BtnFilterIran_Click" Content="Iran" Height="28" Padding="10,2" Margin="0,0,4,0" Background="#1E293B" Foreground="#C084FC" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand" />
                                    <Button x:Name="BtnFilterGlobal" Click="BtnFilterGlobal_Click" Content="Global" Height="28" Padding="10,2" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 1: Actions Toolbar -->
                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnAddResolver" Grid.Column="0" Click="BtnAddResolver_Click" Height="28" Padding="10,2" Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Content="+ Add Resolver" ToolTip="Add a custom resolver IP:port" />
                                <Button x:Name="BtnImportResolversFile" Grid.Column="2" Click="BtnImportResolversFile_Click" Height="28" Padding="10,2" Background="#1E293B" Foreground="#38BDF8" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Content="📂 Import .txt" ToolTip="Import custom candidate resolvers from text file" />
                                <Button x:Name="BtnTestResolvers" Grid.Column="4" Click="BtnTestResolvers_Click" Height="28" Padding="10,2" Background="#1E293B" Foreground="#10B981" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Content="⚡ Test All" ToolTip="Run parallel health &amp; latency test on resolvers" />
                                <Button x:Name="BtnPruneDead" Grid.Column="6" Click="BtnPruneDead_Click" Height="28" Padding="10,2" Background="#1E293B" Foreground="#EF4444" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Content="🧹 Prune Dead" ToolTip="Automatically remove unresponsive dead resolvers" />
                                <Button x:Name="BtnExportResolvers" Grid.Column="8" Click="BtnExportResolvers_Click" Height="28" Padding="10,2" Background="#1E293B" Foreground="#A855F7" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Content="📋 Export" ToolTip="Export current resolvers list to clipboard" />
                                <Button x:Name="BtnToggleRawEditor" Grid.Column="10" Click="BtnToggleRawEditor_Click" Height="28" Padding="10,2" Background="#1E293B" Foreground="#F59E0B" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Content="📝 Raw Editor" ToolTip="Toggle raw text file editor" />
                            </Grid>

                            <!-- Row 2: Status & Counts -->
                            <Grid Grid.Row="2" Margin="0,0,0,6">
                                <TextBlock x:Name="TxtBankCount" Text="40 Resolvers | 14 Healthy in Bank" FontWeight="SemiBold" Foreground="#A855F7" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtTunerStatus" HorizontalAlignment="Right" Text="⚡ Posture: Ready" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Row 3: Card-Style ListView -->
                            <ListView x:Name="LvResolverBank" Grid.Row="3" Background="#080C14" BorderBrush="#1E293B" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="LvResolverBank_KeyDown">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,4" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,2,0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Status Dot -->
                                                <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{Binding StatusBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                
                                                <!-- IP, Port & Tags -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Addr}" FontFamily="Consolas" FontSize="12.5" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <Border Background="{Binding RegionBadgeBackground}" CornerRadius="3" Padding="5,1" Margin="0,0,4,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding RegionTag}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding RegionTagColor}" />
                                                        </Border>
                                                        <Border Background="#064E3B" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding EDNSFormatted}" FontSize="9.5" FontWeight="Bold" Foreground="#34D399" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding StatsSummary}" FontSize="10" Foreground="#64748B" Margin="0,2,0,0" />
                                                </StackPanel>
                                                
                                                <!-- Latency & Score Pill -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <Border Background="#1E293B" CornerRadius="4" Padding="8,4" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding RTTFormatted}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusBrush}" />
                                                    </Border>
                                                    <Border Background="#1E293B" CornerRadius="4" Padding="6,4">
                                                        <TextBlock Text="{Binding ScoreFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                                                    </Border>
                                                </StackPanel>
                                                
                                                <!-- Actions -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Click="BtnTestSingle_Click" Tag="{Binding Addr}" Content="⚡" ToolTip="Test this resolver" Width="26" Height="26" Background="#1E293B" Foreground="#38BDF8" BorderThickness="0" Margin="0,0,4,0" Cursor="Hand" />
                                                    <Button Click="BtnEditSingle_Click" Tag="{Binding Addr}" Content="✏" ToolTip="Edit resolver" Width="26" Height="26" Background="#1E293B" Foreground="#F59E0B" BorderThickness="0" Margin="0,0,4,0" Cursor="Hand" />
                                                    <Button Click="BtnDeleteSingle_Click" Tag="{Binding Addr}" Content="✕" ToolTip="Delete resolver" Width="26" Height="26" Background="#1E293B" Foreground="#EF4444" BorderThickness="0" Cursor="Hand" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Row 4: Raw Editor Panel (Collapsible) -->
                            <Grid x:Name="PnlRawEditor" Grid.Row="4" Margin="0,8,0,0" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="120" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="RAW CANDIDATE RESOLVERS TEXT FILE" FontWeight="SemiBold" Foreground="#F59E0B" FontSize="10.5" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtResolversFile" Grid.Row="1" Text="client_resolvers.txt" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,6" ToolTip="Candidate resolver IPs (one per line)" />
                                <Button x:Name="BtnSaveRawResolvers" Grid.Row="2" Click="BtnSaveRawResolvers_Click" Height="26" Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold" FontSize="11" Content="Save &amp; Apply Changes" HorizontalAlignment="Right" Padding="12,2" Cursor="Hand" />
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Tab 3: Advanced Settings -->
                    <TabItem Header="⚙️ Configuration">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="SERVER CREDENTIALS &amp; ROUTING" FontWeight="SemiBold" Foreground="#38BDF8" FontSize="11" Margin="0,0,0,6" />

                                <!-- Server Public Key -->
                                <TextBlock Text="SERVER PUBLIC KEY (32-BYTE ED25519)" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtServerKey" Margin="0,0,0,10" ToolTip="32-byte Ed25519 Base64 Public Key" />

                                <!-- Tunnel Domains -->
                                <TextBlock Text="TUNNEL DOMAINS (ZONES)" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtDomains" Margin="0,0,0,4" ToolTip="Comma-separated zones, e.g. s.he7.ir, s.he6.ir" />
                                <TextBlock Text="Multi-domain failover racing; automatically switches domains upon filtering" FontSize="10" Foreground="#64748B" Margin="0,0,10,0" />

                                <!-- SOCKS5 Port & IP -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="LISTEN IP" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtListenIP" Text="127.0.0.1" TextChanged="TxtListenPort_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="PORT" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtListenPort" Text="10850" TextChanged="TxtListenPort_TextChanged" />
                                    </StackPanel>
                                </Grid>

                                <!-- Idle Timeout -->
                                <TextBlock Text="STREAM IDLE TIMEOUT (SECONDS)" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtIdleTimeout" Text="60" Margin="0,0,0,14" />

                                <!-- Save Button -->
                                <Button x:Name="BtnSaveConfig" Click="BtnSaveConfig_Click" Height="36" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" BorderThickness="0" Margin="0,0,0,8">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                    Save Profile Changes
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="TxtFooterProxy" Text="SOCKS5: socks5://127.0.0.1:10850 | Telegram: tg://socks?server=127.0.0.1&amp;port=10850" FontSize="11" Foreground="#475569" VerticalAlignment="Center" ToolTip="Click to copy Telegram proxy link" Cursor="Hand" MouseDown="TxtFooterProxy_MouseDown" />
            <TextBlock x:Name="TxtStats" HorizontalAlignment="Right" Text="Idle" FontSize="11" Foreground="#0284C7" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
