<Window x:Class="SoarClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Soar DNS Tunnel" Height="720" Width="980"
        MinHeight="620" MinWidth="850"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1A2230" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#2D3B50" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1A2230" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#2D3B50" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Main Content: Settings & Logs -->
            <RowDefinition Height="*" />
            <!-- Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,14" Padding="4,0,4,12" BorderBrush="#1F2937" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SOAR" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,8,0" />
                        <TextBlock Text="DNS TUNNEL" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,12,0" />
                        <Border Background="#0369A1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="v1.0.2" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Loss-Tolerant Multi-Domain Tunneling | Based on Lantern Soar Protocol" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Right Header: Telemetry & Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Live Speed Indicators -->
                    <Border Background="#111827" CornerRadius="6" Padding="10,5" Margin="0,0,10,0" BorderBrush="#1F2937" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↓ " Foreground="#10B981" FontWeight="Bold" FontSize="11" />
                            <TextBlock x:Name="TxtSpeedRx" Text="0.0 KB/s" Foreground="#F8FAFC" FontSize="11" Margin="0,0,10,0" />
                            <TextBlock Text="↑ " Foreground="#38BDF8" FontWeight="Bold" FontSize="11" />
                            <TextBlock x:Name="TxtSpeedTx" Text="0.0 KB/s" Foreground="#F8FAFC" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <!-- Status Pill -->
                    <Border Background="#161F2E" CornerRadius="16" Padding="12,6" VerticalAlignment="Center" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#EF4444" Margin="0,0,6,0" />
                            <TextBlock x:Name="StatusText" Text="Disconnected" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="11.5" />
                        </StackPanel>
                    </Border>

                    <!-- Check Updates & About -->
                    <Button x:Name="BtnCheckUpdate" Click="BtnCheckUpdate_Click" Height="28" Padding="8,2" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" FontSize="11" Content="Update" Margin="0,0,6,0" ToolTip="Check GitHub for newer versions" />
                    <Button x:Name="BtnAbout" Click="BtnAbout_Click" Height="28" Padding="8,2" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" FontSize="11" Content="About" ToolTip="View protocol credits &amp; license" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Split Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Configuration & Controls (380px) -->
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="16" />
                <!-- Real-time Console Log (Fill) -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Configuration Card -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Server Profile Section -->
                        <TextBlock Text="SERVER PROFILE" FontWeight="SemiBold" Foreground="#38BDF8" FontSize="11" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbProfiles" Grid.Column="0" SelectionChanged="CmbProfiles_SelectionChanged" />
                            <Button x:Name="BtnAddProfile" Grid.Column="2" Click="BtnAddProfile_Click" Content="+" Width="28" Height="28" Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" FontSize="14" BorderBrush="#334155" ToolTip="Add New Server Profile" />
                            <Button x:Name="BtnDeleteProfile" Grid.Column="4" Click="BtnDeleteProfile_Click" Content="✕" Width="28" Height="28" Background="#1E293B" Foreground="#EF4444" FontSize="11" BorderBrush="#334155" ToolTip="Delete Current Profile" />
                        </Grid>

                        <!-- Import / Share Action Bar -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnImportLink" Grid.Column="0" Click="BtnImportLink_Click" Height="28" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" FontSize="11" Content="Import Link" ToolTip="Import soar:// standard or locked link" />
                            <Button x:Name="BtnShareProfile" Grid.Column="2" Click="BtnShareProfile_Click" Height="28" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" FontSize="11" Content="Share..." ToolTip="Share standard or privacy-locked link" />
                        </Grid>

                        <Separator Background="#1F2937" Margin="0,0,0,12" />

                        <!-- Server Public Key -->
                        <TextBlock Text="SERVER PUBLIC KEY" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtServerKey" Margin="0,0,0,10" ToolTip="32-byte Ed25519 Base64 Public Key" />

                        <!-- Tunnel Domains -->
                        <TextBlock Text="TUNNEL DOMAINS (ZONES)" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtDomains" Margin="0,0,0,4" ToolTip="Comma-separated zones, e.g. s.he7.ir, s.he6.ir" />
                        <TextBlock Text="Supports multiple domains for automatic failover" FontSize="10" Foreground="#64748B" Margin="0,0,0,10" />

                        <!-- SOCKS5 Port & IP -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="LISTEN IP" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtListenIP" Text="127.0.0.1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PORT" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtListenPort" Text="10850" />
                            </StackPanel>
                        </Grid>

                        <!-- Resolvers Section -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="RESOLVERS FILE" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Click="BtnTestResolvers_Click" Content="Test Latency" Height="22" Padding="6,1" Background="#1E293B" Foreground="#38BDF8" BorderThickness="0" FontSize="10" ToolTip="Test ping of all candidate resolvers" />
                        </Grid>
                        <TextBox x:Name="TxtResolversFile" Text="client_resolvers.txt" Margin="0,0,0,14" />

                        <!-- System Proxy & Auto-start Options -->
                        <CheckBox x:Name="ChkSystemProxy" Content="Set as Windows System Proxy" Foreground="#E2E8F0" FontSize="11.5" Margin="0,0,0,8" IsChecked="True" ToolTip="Automatically routes Windows and browser traffic through the tunnel" />
                        <CheckBox x:Name="ChkMinimizeToTray" Content="Minimize to System Tray on close" Foreground="#E2E8F0" FontSize="11.5" Margin="0,0,0,14" IsChecked="True" />

                        <!-- Connect / Disconnect Button -->
                        <Button x:Name="BtnConnect" Click="BtnConnect_Click" Height="42" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13.5" BorderThickness="0" Margin="0,0,0,8">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </Button.Resources>
                            CONNECT
                        </Button>

                        <!-- Quick Action Buttons -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnCopyProxy" Grid.Column="0" Click="BtnCopyProxy_Click" Height="30" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" FontSize="11" Content="Copy Proxy Link" />
                            <Button x:Name="BtnSaveConfig" Grid.Column="2" Click="BtnSaveConfig_Click" Height="30" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" FontSize="11" Content="Save Profile" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Live Console Log Card -->
            <Border Grid.Column="2" Background="#0B0F17" CornerRadius="8" Padding="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Log Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="LIVE TELEMETRY &amp; TUNNEL CONSOLE" FontWeight="SemiBold" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Click="BtnClearLogs_Click" Content="Clear" Height="24" Padding="10,2" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" FontSize="11" />
                    </Grid>

                    <!-- Terminal Output -->
                    <TextBox x:Name="TxtConsoleLog" Grid.Row="1" Background="#080C14" Foreground="#10B981" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="Wrap" BorderThickness="0" Padding="8" />
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="SOCKS5: socks5://127.0.0.1:10850 | Telegram: tg://socks?server=127.0.0.1&amp;port=10850" FontSize="11" Foreground="#475569" VerticalAlignment="Center" />
            <TextBlock x:Name="TxtStats" HorizontalAlignment="Right" Text="Idle" FontSize="11" Foreground="#0284C7" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
